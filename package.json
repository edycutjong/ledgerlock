{
  "name": "ledgerlock",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test:ts": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sol": "forge test && FOUNDRY_PROFILE=kit forge test",
    "coverage:sol": "bash script/coverage-gate.sh",
    "e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.16.1 autorun",
    "triples": "tsx scripts/spike-triples.ts",
    "triples:core": "tsx scripts/triples.ts",
    "bench": "script/bench-all.sh frozen3",
    "bench:summary": "tsx scripts/bench-summary.ts",
    "burst:verify": "tsx scripts/burst-verify.ts",
    "status:data": "tsx scripts/status-data.ts frozen3",
    "control": "tsx scripts/control.ts 5",
    "routeb": "tsx scripts/routeb.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "viem": "^2.21.0"
  }
}
