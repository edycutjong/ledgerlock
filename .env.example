# Ledgerlock environment template.
# The scripts read keys from a file OUTSIDE this repo: $LEDGERLOCK_ENV, default ~/.config/reactive/testnet-deployer.env.
# Copy this file there (not into the repo) and fill it in. Testnets only: Reactive Lasna, Base Sepolia, Unichain Sepolia.
# Nothing here is needed to run the tests (`forge test`, `pnpm test:ts`) or to regenerate the numbers (`pnpm bench:summary`).

# ── Deployer account (testnet only) ──────────────────────────
# Get from: any EVM wallet (e.g. `cast wallet new`); fund it from the faucets below. Never reuse a mainnet key.
DEPLOYER_ADDRESS=0xYourDeployerAddress
# Get from: the same wallet's private key export (`cast wallet new` prints it). Keep this file chmod 600.
DEPLOYER_PRIVATE_KEY=0xyour-64-hex-private-key

# ── RPC endpoints (public defaults work) ─────────────────────
# Get from: https://dev.reactive.network/reactive-mainnet#lasna-testnet (public RPC; lREACT faucet on the same page)
LASNA_RPC=https://lasna-rpc.rnk.dev/
# Get from: https://docs.base.org/chain/network-information (public RPC); ETH from https://console.optimism.io/faucet
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Get from: https://docs.unichain.org/docs/technical-information/network-information (public RPC); ETH from https://console.optimism.io/faucet
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org

# ── Optional ─────────────────────────────────────────────────
# Which deployment a script targets (evidence/<instance>-addresses.txt): deploy scripts default to core-dev,
# the heartbeat to frozen3, and the bench takes it as its first argument.
# INSTANCE=frozen3
